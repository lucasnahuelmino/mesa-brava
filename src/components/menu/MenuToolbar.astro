---
import { CATEGORIES } from '../../data/menu';
---

<section class="toolbar" data-menu-toolbar aria-label="Filtros de la carta">
  <div class="shell toolbar__inner">
    <div class="toolbar__search">
      <label class="toolbar__label" for="menu-query">Buscar en la carta</label>
      <div class="toolbar__field">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.2-3.2" />
        </svg>
        <input
          class="toolbar__input"
          id="menu-query"
          type="search"
          placeholder="Ej.: empanadas, cold brew…"
          autocomplete="off"
          data-menu-query
          aria-describedby="menu-count"
        />
        <button class="toolbar__clear" type="button" data-menu-clear hidden>
          Limpiar<span class="visually-hidden"> la búsqueda</span>
        </button>
      </div>
    </div>

    <div class="toolbar__chips" role="group" aria-label="Filtrar por categoría" data-menu-chips>
      <button class="chip" type="button" data-cat="all" aria-pressed="true">Todos</button>
      <button class="chip" type="button" data-cat="featured" aria-pressed="false">Destacados</button>
      {
        CATEGORIES.map((category) => (
          <button class="chip" type="button" data-cat={category.id} aria-pressed="false">
            {category.label}
          </button>
        ))
      }
    </div>

    <label class="toolbar__toggle">
      <input type="checkbox" data-menu-hide-off />
      <span>Ocultar no disponibles</span>
    </label>

    <p class="toolbar__count" id="menu-count" role="status" aria-live="polite" data-menu-count>
      Cargando productos…
    </p>
  </div>
</section>

<style>
  .toolbar {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: color-mix(in srgb, var(--cream) 95%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    padding: 1rem 0;
  }

  .toolbar__inner {
    display: grid;
    gap: 0.9rem;
  }

  .toolbar__label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
    color: var(--ink-soft);
  }

  .toolbar__field {
    position: relative;
    display: flex;
    align-items: center;
  }
  .toolbar__field svg {
    position: absolute;
    left: 0.9rem;
    color: var(--ink-faint);
    pointer-events: none;
  }
  .toolbar__input {
    width: 100%;
    min-height: 50px;
    padding: 0.7rem 6.5rem 0.7rem 2.75rem;
    background: var(--white);
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    font-size: 1rem;
  }
  .toolbar__input::-webkit-search-cancel-button {
    display: none;
  }
  .toolbar__clear {
    position: absolute;
    right: 0.4rem;
    min-height: 38px;
    padding: 0 0.9rem;
    border: 0;
    border-radius: 999px;
    background: var(--cream-deep);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .toolbar__clear:hover {
    background: var(--black);
    color: var(--cream);
  }

  .toolbar__chips {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.35rem;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .chip {
    flex: 0 0 auto;
    min-height: 42px;
    padding: 0.45rem 1rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    font-size: 0.87rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease;
  }
  .chip:hover {
    border-color: var(--ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--black);
    border-color: var(--black);
    color: var(--cream);
  }

  .toolbar__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    font-weight: 600;
    min-height: 44px;
    cursor: pointer;
  }
  .toolbar__toggle input {
    width: 20px;
    height: 20px;
    accent-color: var(--bordeaux);
  }

  .toolbar__count {
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 860px) {
    .toolbar__inner {
      grid-template-columns: minmax(240px, 1fr) auto;
      align-items: start;
      column-gap: 1.5rem;
      row-gap: 0.75rem;
    }
    .toolbar__search {
      grid-column: 1;
    }
    .toolbar__chips {
      grid-column: 1 / -1;
      overflow-x: auto;
    }
    .toolbar__toggle {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }
    .toolbar__count {
      grid-column: 1 / -1;
    }
  }
</style>
