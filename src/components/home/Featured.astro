---
import { getFeatured } from '../../data/menu';
import ProductCard from '../menu/ProductCard.astro';

const featured = getFeatured(4);
const [first, ...rest] = featured;
---

<section class="featured" aria-labelledby="featured-title">
  <div class="shell">
    <header class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">Lo más pedido</p>
        <h2 id="featured-title" class="section-title">Platos destacados</h2>
        <p class="section-head__lede">
          Cuatro lugares para empezar. Todos se piden desde la carta y se agregan al pedido que
          después enviás por WhatsApp.
        </p>
      </div>
      <a class="text-link" href="/carta">Ver la carta completa <span aria-hidden="true">→</span></a>
    </header>

    <div class="featured__grid">
      <div class="featured__hero">
        <ProductCard product={first} variant="feature" />
      </div>

      <ol class="featured__list">
        {
          rest.map((product, index) => (
            <li>
              <ProductCard product={product} index={`0${index + 2}`} />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .featured {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    background: var(--cream);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }
  .section-head__text {
    display: grid;
    gap: 0.75rem;
  }
  .section-head__lede {
    color: var(--ink-soft);
    max-width: 58ch;
    font-size: 0.98rem;
  }

  .featured__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .featured__list {
    display: grid;
    align-content: start;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 960px) {
    .featured__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: start;
    }
  }
</style>
