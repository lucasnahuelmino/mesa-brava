---
import { Image } from 'astro:assets';
import local from '../../assets/images/editorial-local.jpg';
import mesa from '../../assets/images/editorial-mesa-compartida.jpg';

const pillars = [
  {
    title: 'De día, cafetería',
    text: 'Mesa para trabajar, desayuno largo y café recién molido desde las 08:00.',
  },
  {
    title: 'De noche, parrilla',
    text: 'Platos para poner en el medio de la mesa, cocción a fuego y porciones honestas.',
  },
  {
    title: 'Siempre, la misma mesa',
    text: 'Sin reservas obligatorias ni música alta: lugar para quedarse charlando.',
  },
];
---

<section class="local" aria-labelledby="local-title">
  <div class="shell local__inner">
    <div class="local__media">
      <figure class="local__figure media" data-fallback="el local">
        <Image
          src={local}
          alt="Interior del restaurante con mesas, sillas de madera y luz cálida"
          widths={[480, 800, 1100]}
          sizes="(min-width: 900px) 52vw, 100vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="local__figure local__figure--inset media" data-fallback="la mesa">
        <Image
          src={mesa}
          alt="Grupo compartiendo platos y bebidas sobre una mesa vista desde arriba"
          widths={[320, 560]}
          sizes="(min-width: 900px) 24vw, 60vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <div class="local__copy">
      <p class="eyebrow">El local</p>
      <h2 id="local-title" class="section-title">Una mesa grande, tres momentos del día</h2>
      <p class="local__lede">
        MESA BRAVA nació de una idea simple: un lugar de barrio con cocina seria y servicio sin
        apuro. Abrimos temprano para el café, al mediodía servimos la carta completa y de noche la
        barra se queda hasta último momento.
      </p>

      <blockquote class="local__quote">
        «No somos rápidos ni lentos: somos el tiempo que necesitás para comer bien.»
      </blockquote>

      <ul class="local__pillars">
        {
          pillars.map((pillar) => (
            <li>
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
            </li>
          ))
        }
      </ul>

      <a class="text-link" href="/nosotros">
        Conocer la historia del lugar <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .local {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    background: var(--cream);
    border-top: 1px solid var(--line);
  }

  .local__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .local__media {
    position: relative;
    display: grid;
    gap: 1rem;
  }
  .local__figure {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 11;
  }
  .local__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .local__figure--inset {
    aspect-ratio: 16 / 9;
    width: 74%;
    margin-left: auto;
    margin-top: -18%;
    border: 8px solid var(--cream);
    position: relative;
    z-index: 1;
    box-shadow: var(--shadow-lg);
  }

  .local__copy {
    display: grid;
    gap: 1.15rem;
    align-content: center;
  }
  .local__lede {
    color: var(--ink-soft);
    line-height: 1.7;
    max-width: 58ch;
  }

  .local__quote {
    margin: 0.5rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--bordeaux);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 1rem + 1vw, 1.5rem);
    line-height: 1.35;
    color: var(--bordeaux);
    max-width: 34ch;
  }

  .local__pillars {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .local__pillars h3 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--olive-dark);
    margin-bottom: 0.35rem;
  }
  .local__pillars p {
    font-size: 0.95rem;
    color: var(--ink-soft);
    max-width: 44ch;
  }

  @media (min-width: 760px) {
    .local__pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (min-width: 960px) {
    .local__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 5rem);
      align-items: center;
    }
    .local__copy {
      order: 2;
    }
  }
</style>
