---
import { Image } from 'astro:assets';
import cafe from '../../assets/images/editorial-cafe.jpg';
import croissant from '../../assets/images/croissant.jpg';

const items = [
  { name: 'Espresso doble', price: '$ 3.200' },
  { name: 'Flat white', price: '$ 4.600' },
  { name: 'Cold brew de 18 horas', price: '$ 4.900' },
  { name: 'Croissant de manteca', price: '$ 3.600' },
];
---

<section class="coffee" aria-labelledby="coffee-title">
  <div class="shell coffee__inner">
    <div class="coffee__media">
      <figure class="coffee__figure coffee__figure--main media" data-fallback="café">
        <Image
          src={cafe}
          alt="Tazas de café con leche sobre una mesa de madera visto desde arriba"
          widths={[480, 760]}
          sizes="(min-width: 900px) 34vw, 88vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="coffee__figure coffee__figure--small media" data-fallback="pastelería">
        <Image
          src={croissant}
          alt="Croissants dorados recién salidos del horno"
          widths={[320, 520]}
          sizes="(min-width: 900px) 22vw, 46vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="coffee__caption">Horneado cada mañana</figcaption>
      </figure>
    </div>

    <div class="coffee__copy">
      <p class="eyebrow eyebrow--light">Café de especialidad · pastelería de la casa</p>
      <h2 id="coffee-title" class="section-title coffee__title">
        El café no se apura,<br />la mesa tampoco
      </h2>
      <p class="coffee__lede">
        Tostamos en semana y moliemos por pedido. Si preferís filtrado, lo hacemos lento. Y si venís
        por la pastelería: croissants, tortas y cookies salen del horno detrás de la barra.
      </p>

      <ul class="coffee__list">
        {
          items.map((item) => (
            <li>
              <span class="coffee__item">{item.name}</span>
              <span class="coffee__dots" aria-hidden="true" />
              <span class="price coffee__price">{item.price}</span>
            </li>
          ))
        }
      </ul>

      <a class="btn btn--cream" href="/carta#cafe">Ver café y pastelería</a>
    </div>
  </div>
</section>

<style>
  .coffee {
    background: var(--black);
    color: var(--cream);
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    overflow: hidden;
  }

  .coffee__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .coffee__media {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: end;
  }
  .coffee__figure {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .coffee__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .coffee__figure--main {
    grid-column: 1 / 6;
    aspect-ratio: 4 / 3;
  }
  .coffee__figure--small {
    grid-column: 4 / 7;
    aspect-ratio: 1 / 1;
    margin-top: -30%;
    margin-left: auto;
    width: 72%;
    border: 6px solid var(--black);
    position: relative;
    z-index: 1;
  }
  .coffee__caption {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    padding: 0.5rem 0.6rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    background: rgba(36, 35, 34, 0.82);
    color: var(--cream);
  }

  .coffee__copy {
    display: grid;
    gap: 1.15rem;
    align-content: center;
  }
  .coffee__title {
    font-size: clamp(1.9rem, 1.2rem + 3vw, 3rem);
  }
  .coffee__lede {
    color: rgba(245, 240, 230, 0.8);
    max-width: 52ch;
    line-height: 1.65;
  }

  .coffee__list {
    display: grid;
    gap: 0.75rem;
    margin: 0.5rem 0 0.75rem;
    max-width: 30rem;
  }
  .coffee__list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.98rem;
  }
  .coffee__dots {
    flex: 1 1 auto;
    border-bottom: 1.5px dotted rgba(245, 240, 230, 0.4);
    transform: translateY(-0.3em);
  }
  .coffee__item {
    color: rgba(245, 240, 230, 0.92);
  }
  .coffee__price {
    color: var(--cream);
    white-space: nowrap;
  }

  .coffee__copy :global(.btn) {
    justify-self: start;
  }

  @media (min-width: 900px) {
    .coffee__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: clamp(3rem, 6vw, 5rem);
      align-items: center;
    }
    .coffee__figure--small {
      width: 66%;
      margin-top: -34%;
    }
  }
</style>
