---
import { CATALOG } from '../../data/menu';
---

<div class="cart-overlay" data-cart-overlay hidden></div>

<aside
  class="cart"
  data-cart-drawer
  data-catalog={JSON.stringify(CATALOG)}
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-title"
  hidden
>
  <header class="cart__head">
    <div>
      <p class="eyebrow">Pedido por WhatsApp</p>
      <h2 id="cart-title" class="cart__title">Tu pedido</h2>
    </div>
    <button class="cart__close" type="button" data-cart-close aria-label="Cerrar el pedido">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none"
        stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </header>

  <div class="cart__body" data-cart-body>
    <ul class="cart__lines" data-cart-lines></ul>

    <div class="cart__empty" data-cart-empty>
      <div class="empty-state">
        <h3>Tu pedido está vacío</h3>
        <p>Elegí platos de la carta y agregalos acá. Los precios se calculan solos.</p>
        <a class="btn btn--sm" href="/carta">Ver la carta</a>
      </div>
    </div>

    <p class="cart__notice" data-cart-notice hidden></p>
  </div>

  <footer class="cart__foot">
    <div class="cart__subtotal">
      <span>Subtotal</span>
      <strong class="price" data-cart-subtotal>$ 0</strong>
    </div>
    <p class="cart__hint">
      El subtotal es una referencia. El restaurante confirma disponibilidad, entrega y total final
      por WhatsApp. No se realiza ningún cobro en este sitio.
    </p>
    <button class="btn btn--block" type="button" data-cart-checkout disabled>
      Continuar por WhatsApp
      <span aria-hidden="true">→</span>
    </button>
    <div class="cart__foot-actions">
      <button class="cart__link" type="button" data-cart-clear disabled>Vaciar pedido</button>
      <a class="cart__link" href="/carta">Seguir viendo la carta</a>
    </div>
  </footer>
</aside>

<div class="toast" data-cart-toast role="status" aria-live="polite" hidden></div>

<script>
  import {
    addToCart,
    cartCount,
    cartSubtotal,
    clearCart,
    readCart,
    removeFromCart,
    resolveCart,
    setQty,
  } from '../../lib/cart';
  import { buildOrderMessage, waLink } from '../../lib/whatsapp';
  import { formatARS } from '../../lib/format';
  import type { CatalogItem } from '../../data/menu';

  const drawer = document.querySelector<HTMLElement>('[data-cart-drawer]');
  const overlay = document.querySelector<HTMLElement>('[data-cart-overlay]');
  const linesEl = document.querySelector<HTMLElement>('[data-cart-lines]');
  const emptyEl = document.querySelector<HTMLElement>('[data-cart-empty]');
  const subtotalEl = document.querySelector<HTMLElement>('[data-cart-subtotal]');
  const noticeEl = document.querySelector<HTMLElement>('[data-cart-notice]');
  const checkoutBtn = document.querySelector<HTMLButtonElement>('[data-cart-checkout]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-cart-clear]');
  const toastEl = document.querySelector<HTMLElement>('[data-cart-toast]');

  /* Catálogo central: la misma fuente que usa la carta, serializada en el HTML. */
  const catalog: CatalogItem[] = drawer?.dataset.catalog
    ? (JSON.parse(drawer.dataset.catalog) as CatalogItem[])
    : [];

  let lastFocused: HTMLElement | null = null;
  let toastTimer: number | undefined;

  const ESCAPE_MAP: Record<string, string> = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  };
  const esc = (value: string) => value.replace(/[&<>"']/g, (char) => ESCAPE_MAP[char] ?? char);

  function render() {
    const lines = resolveCart(readCart(), catalog);
    const count = cartCount();
    const subtotal = cartSubtotal(lines);

    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
      el.textContent = String(count);
    });
    document.querySelectorAll<HTMLElement>('[data-cart-count-text]').forEach((el) => {
      el.textContent = `(${count} ${count === 1 ? 'artículo' : 'artículos'})`;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-cart-add]').forEach((btn) => {
      const inCart = lines.some((line) => line.id === btn.dataset.cartAdd);
      btn.classList.toggle('is-added', inCart);
    });

    if (!linesEl || !emptyEl || !subtotalEl) return;

    linesEl.innerHTML = lines
      .map(
        (line) => `
      <li class="cart__line" data-line="${esc(line.id)}">
        <div class="cart__line-media media" data-fallback="sin foto">
          <img src="${esc(line.image)}" alt="" width="72" height="72" loading="lazy" decoding="async" />
        </div>
        <div class="cart__line-main">
          <p class="cart__line-name">${esc(line.name)}</p>
          <p class="cart__line-unit price">${formatARS(line.price)} c/u</p>
          <div class="cart__line-controls">
            <div class="cart__stepper" role="group" aria-label="Cantidad de ${esc(line.name)}">
              <button type="button" data-cart-dec="${esc(line.id)}" aria-label="Quitar una unidad de ${esc(line.name)}">−</button>
              <span aria-live="polite">${line.qty}</span>
              <button type="button" data-cart-inc="${esc(line.id)}" aria-label="Agregar una unidad de ${esc(line.name)}">+</button>
            </div>
            <button class="cart__remove" type="button" data-cart-remove="${esc(line.id)}">
              Quitar<span class="visually-hidden"> ${esc(line.name)} del pedido</span>
            </button>
          </div>
        </div>
        <p class="cart__line-total price">${formatARS(line.lineTotal)}</p>
      </li>`,
      )
      .join('');

    emptyEl.hidden = lines.length > 0;
    subtotalEl.textContent = formatARS(subtotal);
    if (checkoutBtn) checkoutBtn.disabled = lines.length === 0;
    if (clearBtn) clearBtn.disabled = lines.length === 0;
  }

  function openCart() {
    if (!drawer || !overlay) return;
    lastFocused = document.activeElement as HTMLElement;
    drawer.hidden = false;
    overlay.hidden = false;
    document.body.classList.add('is-locked');
    drawer.querySelector<HTMLElement>('[data-cart-close]')?.focus();
  }

  function closeCart() {
    if (!drawer || !overlay) return;
    drawer.hidden = true;
    overlay.hidden = true;
    document.body.classList.remove('is-locked');
    lastFocused?.focus();
  }

  function showToast(message: string) {
    if (!toastEl) return;
    toastEl.innerHTML = message;
    toastEl.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toastEl.hidden = true;
    }, 3600);
  }

  function showNotice(message: string) {
    if (!noticeEl) return;
    noticeEl.textContent = message;
    noticeEl.hidden = false;
  }

  /* ---------- interacciones globales ---------- */
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    if (target.closest('[data-cart-open]')) {
      event.preventDefault();
      openCart();
      return;
    }
    if (target.closest('[data-cart-close]') || target.closest('[data-cart-overlay]')) {
      closeCart();
      return;
    }

    const addBtn = target.closest<HTMLElement>('[data-cart-add]');
    if (addBtn && !addBtn.hasAttribute('disabled')) {
      addToCart(addBtn.dataset.cartAdd as string);
      render();
      if (noticeEl) noticeEl.hidden = true;
      const name = addBtn.dataset.cartName ?? 'Producto';
      showToast(
        `Agregado: <strong>${name}</strong> <a href="#" data-cart-open>ver pedido</a>`,
      );
      return;
    }

    const inc = target.closest<HTMLElement>('[data-cart-inc]');
    if (inc) {
      const id = inc.dataset.cartInc as string;
      const current = readCart().find((line) => line.id === id);
      setQty(id, (current?.qty ?? 0) + 1);
      render();
      return;
    }

    const dec = target.closest<HTMLElement>('[data-cart-dec]');
    if (dec) {
      const id = dec.dataset.cartDec as string;
      const current = readCart().find((line) => line.id === id);
      setQty(id, (current?.qty ?? 0) - 1);
      render();
      return;
    }

    const remove = target.closest<HTMLElement>('[data-cart-remove]');
    if (remove) {
      removeFromCart(remove.dataset.cartRemove as string);
      render();
      showToast('Quitamos el artículo del pedido.');
      return;
    }

    if (target.closest('[data-cart-clear]')) {
      clearCart();
      if (noticeEl) noticeEl.hidden = true;
      render();
      showToast('Pedido vaciado.');
      return;
    }

    if (target.closest('[data-cart-checkout]')) {
      const lines = resolveCart(readCart(), catalog);
      if (lines.length === 0) return;
      const subtotal = cartSubtotal(lines);
      const message = buildOrderMessage(
        lines.map((line) => ({ name: line.name, qty: line.qty, price: line.price })),
        subtotal,
      );
      window.open(waLink(message), '_blank', 'noopener,noreferrer');
      showNotice(
        'Abrimos WhatsApp con el resumen escrito. Ahí podés revisarlo antes de enviarlo: el pedido no está confirmado ni cobrado hasta que el restaurante responda.',
      );
      return;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer && !drawer.hidden) {
      closeCart();
      return;
    }
    // Trampa de foco simple dentro del panel.
    if (event.key === 'Tab' && drawer && !drawer.hidden) {
      const focusables = Array.from(
        drawer.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => el.offsetParent !== null);
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  document.addEventListener('mb:cartchange', render);
  render();
</script>

<style is:global>
  .cart-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(36, 35, 34, 0.55);
    backdrop-filter: blur(2px);
  }
  .cart-overlay[hidden] {
    display: none;
  }

  .cart {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    height: 100dvh;
    width: min(100%, 440px);
    display: flex;
    flex-direction: column;
    background: var(--cream);
    box-shadow: var(--shadow-lg);
    animation: cart-in 0.24s ease;
  }
  .cart[hidden] {
    display: none;
  }
  @keyframes cart-in {
    from {
      transform: translateX(24px);
      opacity: 0;
    }
  }

  .cart__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.25rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .cart__title {
    font-size: clamp(1.6rem, 6vw, 2rem);
    margin-top: 0.35rem;
  }
  .cart__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--line-strong);
    border-radius: 50%;
    background: transparent;
    transition: background-color 0.16s ease, color 0.16s ease;
  }
  .cart__close:hover {
    background: var(--black);
    color: var(--cream);
  }

  .cart__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .cart__lines {
    display: grid;
    gap: 1rem;
  }
  .cart__line {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 0.9rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .cart__line-media {
    width: 72px;
    height: 72px;
    border-radius: var(--radius);
  }
  .cart__line-main {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }
  .cart__line-name {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .cart__line-unit {
    font-size: 0.8rem;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .cart__line-total {
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .cart__line-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .cart__stepper {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    overflow: hidden;
    background: var(--white);
  }
  .cart__stepper button {
    width: 38px;
    height: 38px;
    border: 0;
    background: transparent;
    font-size: 1.1rem;
    line-height: 1;
    transition: background-color 0.15s ease;
  }
  .cart__stepper button:hover {
    background: var(--cream-deep);
  }
  .cart__stepper span {
    min-width: 2rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .cart__remove,
  .cart__link {
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--bordeaux);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .cart__remove:hover,
  .cart__link:hover {
    color: var(--bordeaux-light);
  }
  .cart__link:disabled {
    color: var(--ink-faint);
    cursor: not-allowed;
    text-decoration: none;
  }

  .cart__notice {
    font-size: 0.85rem;
    line-height: 1.55;
    background: rgba(119, 122, 80, 0.14);
    border-left: 3px solid var(--olive);
    padding: 0.75rem 0.9rem;
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .cart__foot {
    border-top: 1px solid var(--line);
    padding: 1.1rem 1.25rem 1.4rem;
    display: grid;
    gap: 0.85rem;
    background: var(--cream);
  }
  .cart__subtotal {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .cart__subtotal strong {
    font-size: 1.35rem;
  }
  .cart__hint {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .cart__foot-actions {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .toast {
    position: fixed;
    z-index: 110;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    width: min(calc(100% - 2rem), 420px);
    background: var(--black);
    color: var(--cream);
    border-radius: 999px;
    padding: 0.8rem 1.2rem;
    font-size: 0.9rem;
    text-align: center;
    box-shadow: var(--shadow-lg);
    animation: toast-in 0.2s ease;
  }
  .toast[hidden] {
    display: none;
  }
  .toast :global(a) {
    color: var(--cream);
    font-weight: 700;
    margin-left: 0.35rem;
  }
  @keyframes toast-in {
    from {
      transform: translate(-50%, 12px);
      opacity: 0;
    }
  }
</style>
