---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { SITE } from '../config/site';

import imgLocal from '../assets/images/editorial-nosotros-1.jpg';
import imgMesa from '../assets/images/editorial-nosotros-2.jpg';
import imgGente from '../assets/images/editorial-nosotros-3.jpg';
import imgBarra from '../assets/images/editorial-nosotros-4.jpg';
import imgAmbiente from '../assets/images/editorial-ambiente.jpg';

const title = `Nosotros · ${SITE.name}`;
const description =
  'La historia ficticia de MESA BRAVA: cómo nació el local, qué proponemos en la cocina y cómo trabajamos el café y la pastelería. Sitio demo de ALMATE Digital Studio.';

const timeline = [
  {
    year: '2019',
    title: 'La primera mesa',
    text: 'Abrimos en un local de planta baja con doce mesas, una parrilla chica y una cafetería que empezó como anexo.',
  },
  {
    year: '2021',
    title: 'La barra de café',
    text: 'Sumamos tueste propio en semana, métodos de filtrado y una pastelería que pasa a ser diaria.',
  },
  {
    year: '2024',
    title: 'La mudanza',
    text: 'Nos agrandamos una cuadra: mesas más largas, cocina abierta y lugar para los grupos sin perder el barrio.',
  },
];

const pillars = [
  {
    index: '01',
    title: 'Producto de cerca',
    text: 'Compramos cortes, verduras y panificados con proveedores de la ciudad. La carta cambia cuando cambia la estación.',
  },
  {
    index: '02',
    title: 'Cocción sin apuro',
    text: 'Fermentaciones largas, guisos que salen a fuego lento y nada que salga de una freidora industrial.',
  },
  {
    index: '03',
    title: 'Servicio cercano',
    text: 'Te explicamos lo que necesites, sin discurso de sommelier ni prisa por liberar la mesa.',
  },
];
---

<BaseLayout title={title} description={description} path="/nosotros">
  <section class="story-hero">
    <div class="shell story-hero__inner">
      <div class="story-hero__copy">
        <p class="eyebrow">Nosotros</p>
        <h1 class="story-hero__title">Una casa de barrio con cocina seria</h1>
        <p class="lede">
          MESA BRAVA es un restaurante ficticio creado para esta demo. Aun así, la historia que
          contamos es la misma que contaría cualquier local que se toma en serio la mesa: producto,
          tiempo y gente que atiende de frente.
        </p>
      </div>
      <figure class="story-hero__media media" data-fallback="el salón">
        <Image
          src={imgLocal}
          alt="Salón del restaurante con mesas de madera, sillas y paredes de ladrillo"
          widths={[520, 860, 1200]}
          sizes="(min-width: 860px) 56vw, 100vw"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="story-body" aria-labelledby="historia-title">
    <div class="shell story-body__inner">
      <div class="story-body__text">
        <h2 id="historia-title" class="section-title">De dónde salimos</h2>
        <p>
          Empezamos con una idea corta: un lugar donde se pueda desayunar sin mirar el reloj,
          almorzar algo hecho en casa y volver de noche por una tabla para compartir. Nada de
          conceptos importados ni de platos que necesitan explicación en seis líneas.
        </p>
        <p>
          La cocina trabaja con lo que hay: cortes de la semana, verduras de estación y masas que
          descansan lo que tienen que descansar. Si algo no está bien, no entra a la carta. Por eso
          algunos platos aparecen y otros se van.
        </p>
        <blockquote class="story-body__quote">
          «Un restaurante no se mide por la cantidad de platos, sino por cuántos volverías a pedir.»
        </blockquote>
        <p>
          El café es el otro eje. Tostamos en cantidades chicas durante la semana, moliemos por
          pedido y servimos métodos de filtrado para quien los pide. La pastelería sale del horno
          detrás de la barra: croissants, tortas y cookies, todos los días, hasta que se acaba.
        </p>
      </div>

      <figure class="story-body__media media" data-fallback="la mesa">
        <Image
          src={imgMesa}
          alt="Plato principal emplatado junto a dos copas de vino sobre una mesa"
          widths={[420, 720]}
          sizes="(min-width: 860px) 34vw, 100vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption>La carta cambia con la estación.</figcaption>
      </figure>
    </div>
  </section>

  <section class="timeline" aria-labelledby="timeline-title">
    <div class="shell">
      <p class="eyebrow eyebrow--light">Cronología ficticia</p>
      <h2 id="timeline-title" class="section-title timeline__title">Tres momentos del local</h2>
      <ol class="timeline__list">
        {
          timeline.map((item) => (
            <li>
              <p class="timeline__year">{item.year}</p>
              <h3 class="timeline__name">{item.title}</h3>
              <p class="timeline__text">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="pillars" aria-labelledby="pillars-title">
    <div class="shell">
      <header class="pillars__head">
        <p class="eyebrow">Propuesta gastronómica</p>
        <h2 id="pillars-title" class="section-title">Cómo cocinamos</h2>
      </header>
      <ol class="pillars__list">
        {
          pillars.map((pillar) => (
            <li class="pillars__item">
              <span class="pillars__index" aria-hidden="true">
                {pillar.index}
              </span>
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="gallery" aria-label="Fotografías del local">
    <div class="shell--wide gallery__inner">
      <figure class="gallery__item gallery__item--tall media" data-fallback="el salón">
        <Image
          src={imgGente}
          alt="Personas conversando en mesas del local durante el servicio"
          widths={[420, 760]}
          sizes="(min-width: 760px) 30vw, 100vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="gallery__item gallery__item--wide media" data-fallback="la barra">
        <Image
          src={imgBarra}
          alt="Barra del café con plantas, mesas y estanterías"
          widths={[420, 760]}
          sizes="(min-width: 760px) 30vw, 100vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="gallery__item gallery__item--wide media" data-fallback="ambiente">
        <Image
          src={imgAmbiente}
          alt="Mesa junto a la ventana con una merienda servida"
          widths={[520, 960]}
          sizes="(min-width: 760px) 38vw, 100vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="story-cta">
    <div class="shell story-cta__inner">
      <div>
        <p class="eyebrow">Seguí mirando</p>
        <h2 class="story-cta__title">¿Te quedaste con hambre?</h2>
        <p class="story-cta__text">
          En la <a href="/carta">carta completa</a> tenés precios, filtros y disponibilidad de cada
          plato, y desde ahí armás el pedido que después enviás por WhatsApp.
        </p>
      </div>
      <div class="story-cta__actions">
        <a class="btn" href="/carta">Ver la carta</a>
        <a class="btn btn--outline" href="/reservas">Reservar mesa</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- hero ---------------- */
  .story-hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 5vw, 3.5rem);
  }
  .story-hero__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }
  .story-hero__copy {
    display: grid;
    gap: 1rem;
  }
  .story-hero__title {
    font-size: clamp(2.3rem, 1.4rem + 4.4vw, 4rem);
    letter-spacing: -0.03em;
    max-width: 16ch;
  }
  .story-hero__media {
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* ---------------- texto ---------------- */
  .story-body {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .story-body__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .story-body__text {
    display: grid;
    gap: 1.15rem;
    max-width: 66ch;
  }
  .story-body__text p {
    color: var(--ink-soft);
    line-height: 1.75;
  }
  .story-body__quote {
    margin: 0.75rem 0;
    padding: 1.25rem 0 1.25rem 1.5rem;
    border-left: 4px solid var(--bordeaux);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 1rem + 1.3vw, 1.7rem);
    line-height: 1.35;
    color: var(--bordeaux);
  }
  .story-body__media {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
  }
  .story-body__media figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    padding: 0.6rem 0.9rem;
    font-size: 0.78rem;
    background: rgba(36, 35, 34, 0.82);
    color: var(--cream);
  }

  /* ---------------- cronología ---------------- */
  .timeline {
    background: var(--bordeaux);
    color: var(--cream);
    padding: clamp(3rem, 7vw, 5rem) 0;
  }
  .timeline__title {
    margin: 0.75rem 0 clamp(2rem, 5vw, 3rem);
  }
  .timeline__list {
    display: grid;
    gap: 2rem;
  }
  .timeline__list li {
    padding-top: 1.25rem;
    border-top: 1.5px solid rgba(245, 240, 230, 0.35);
  }
  .timeline__year {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.5vw, 3rem);
    line-height: 1;
    color: #e8b4ac;
  }
  .timeline__name {
    font-size: 1.25rem;
    margin: 0.75rem 0 0.5rem;
  }
  .timeline__text {
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(245, 240, 230, 0.82);
    max-width: 44ch;
  }

  /* ---------------- pilares ---------------- */
  .pillars {
    padding: clamp(3rem, 7vw, 5rem) 0;
  }
  .pillars__head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .pillars__list {
    display: grid;
    gap: 2rem;
  }
  .pillars__item {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }
  .pillars__index {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--olive-dark);
  }
  .pillars__item h3 {
    font-size: 1.3rem;
  }
  .pillars__item p {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  /* ---------------- galería ---------------- */
  .gallery {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .gallery__inner {
    display: grid;
    gap: 1rem;
  }
  .gallery__item {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  /* ---------------- cta ---------------- */
  .story-cta {
    background: var(--cream-deep);
    border-top: 1px solid var(--line);
    padding: clamp(2.5rem, 6vw, 4rem) 0;
  }
  .story-cta__inner {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  .story-cta__title {
    font-size: clamp(1.8rem, 1.3rem + 2.5vw, 2.8rem);
    margin: 0.75rem 0;
  }
  .story-cta__text {
    color: var(--ink-soft);
    max-width: 56ch;
  }
  .story-cta__text a {
    color: var(--bordeaux);
    font-weight: 600;
  }
  .story-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 860px) {
    .story-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
    .story-body__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4rem);
    }
    .timeline__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 4vw, 3rem);
    }
    .pillars__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 4vw, 3rem);
    }
    .gallery__inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 240px;
    }
    .gallery__item {
      aspect-ratio: auto;
      height: 100%;
    }
    .gallery__item--tall {
      grid-row: span 2;
    }
    .gallery__item--wide {
      grid-column: span 2;
    }
    .story-cta__inner {
      grid-template-columns: minmax(0, 1.5fr) auto;
    }
  }
</style>
